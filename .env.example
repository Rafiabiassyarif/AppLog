# Salin ke .env lalu isi. File .env tidak boleh masuk repository.

# Koneksi MySQL: pakai DATABASE_URL, atau DB_* di bawah.
DATABASE_URL=mysql://applog:ganti-password-kuat@127.0.0.1:3306/applog
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=applog
# DB_PASSWORD=ganti-password-kuat
# DB_NAME=applog

HOST=127.0.0.1
PORT=4173

# Isi 1 jika server berada di belakang reverse proxy HTTPS (Nginx, Caddy, Cloudflare).
TRUST_PROXY=1
